
extends layout

block content
    .page-heading
        .eyebrow DATA MANAGEMENT
        h1 Calculation History
        p Quản lý toàn bộ lịch sử tính toán được lưu trong JSON.

    .metrics-grid
        .metric-card.cyan
            .metric-label TỔNG BẢN GHI
            h2= stats.total

        .metric-card.green
            .metric-label THÀNH CÔNG
            h2= stats.success

        .metric-card.red
            .metric-label THẤT BẠI
            h2= stats.errors

        .metric-card.purple
            .metric-label KẾT QUẢ TÌM KIẾM
            h2= history.length

    section.panel
        .panel-heading
            h2 Lịch sử hoạt động
            a.btn.btn-primary(href="/history/export") ↓ Xuất báo cáo TXT

        .toolbar
            form.search-form(action="/history" method="GET")
                input(type="search" name="keyword" value=keyword placeholder="Tìm phép tính, kết quả...")
                button.btn.btn-primary(type="submit") Tìm kiếm
                a.btn.btn-secondary(href="/history") Làm mới

            form(action="/history/clear" method="POST" data-confirm="Bạn có muốn xóa toàn bộ lịch sử không?")
                button.btn.btn-danger(type="submit") Xóa toàn bộ

        if history.length
            .table-wrapper
                table.data-table
                    thead
                        tr
                            th STT
                            th Phép tính
                            th Kết quả
                            th Thời gian
                            th Trạng thái
                            th Thao tác

                    tbody
                        each item, index in history
                            tr
                                td= index + 1
                                td
                                    strong= item.expression || item.operationName
                                    if item.status === "error"
                                        small.error-text= item.message

                                td= item.result === null ? "---" : item.result

                                td= new Date(item.createdAt).toLocaleString("vi-VN")

                                td
                                    span(class=item.status === "success" ? "status-success" : "status-error")= item.status === "success" ? "SUCCESS" : "ERROR"

                                td
                                    .table-actions
                                        if item.status === "success"
                                            button.btn.btn-secondary.btn-small(type="button" data-copy=item.expression) Copy

                                        form(action="/history/delete/" + item.id method="POST" data-confirm="Xóa phép tính này?")
                                            button.btn.btn-danger.btn-small(type="submit") Xóa

        else
            .empty-state
                h3 Không có dữ liệu
                p Chưa có phép tính hoặc không tìm thấy kết quả phù hợp.
                a.btn.btn-primary(href="/calculator") Thực hiện phép tính

    .panel
        h3 JSON Storage
        p.muted Lịch sử được lưu tại data/history.json và vẫn tồn tại sau khi khởi động lại máy chủ.
        a.text-link(href="/api/history" target="_blank" rel="noopener") Xem dữ liệu JSON →
