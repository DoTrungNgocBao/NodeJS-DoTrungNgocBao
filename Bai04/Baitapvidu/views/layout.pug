
doctype html
html(lang="vi")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= title + " | NEXUS X"
        link(rel="stylesheet" href="/styles.css")

    body
        .app-shell
            aside.sidebar
                a.brand(href="/")
                    .brand-icon ◈
                    .brand-text
                        h2 NEXUS X
                        small CALCULATOR STUDIO

                .menu-label WORKSPACE

                nav.navigation
                    a.nav-link(href="/" class=activePage === "home" ? "active" : "")
                        span.nav-icon ▦
                        span Tổng quan

                    a.nav-link(href="/calculator" class=activePage === "calculator" ? "active" : "")
                        span.nav-icon ⌘
                        span Máy tính

                    a.nav-link(href="/history" class=activePage === "history" ? "active" : "")
                        span.nav-icon ◷
                        span Lịch sử

                    a.nav-link(href="/statistics" class=activePage === "statistics" ? "active" : "")
                        span.nav-icon ▥
                        span Thống kê

                .menu-label DEVELOPER

                nav.navigation
                    a.nav-link(href="/system" class=activePage === "system" ? "active" : "")
                        span.nav-icon ⚙
                        span Hệ thống

                    a.nav-link(href="/about" class=activePage === "about" ? "active" : "")
                        span.nav-icon ⓘ
                        span Giới thiệu

                .sidebar-bottom
                    .online-status
                        span.status-dot
                        span SYSTEM ONLINE
                    small Express Framework
                    small Version 1.0.0

            .main-wrapper
                header.topbar
                    .topbar-left
                        button#menuToggle.icon-button(type="button" aria-label="Mở menu") ☰
                        span.breadcrumb NEXUS X / 
                        strong= title

                    .topbar-right
                        span#liveClock.clock --:--:--
                        button#themeToggle.icon-button(type="button" aria-label="Đổi giao diện") ◐
                        .avatar NB

                main.main-content
                    block content

                footer.footer
                    p NEXUS X — SMART CALCULATOR STUDIO
                    p Đỗ Trung Ngọc Bảo | CD-CNTT18A05 | CD-CNTT18A
                    small Node.js · Express · MVC · Pug

        script(src="/script.js")
