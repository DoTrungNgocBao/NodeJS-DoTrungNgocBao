
extends layout

block content
    .page-heading
        .eyebrow CALCULATION WORKSPACE
        h1 Smart Calculator
        p Thực hiện phép tính thông qua Express và mô hình MVC.

    .dashboard-grid
        section.panel
            .panel-heading
                h2 Nhập dữ liệu
                span.tag POST REQUEST

            form.calculation-form(action="/calculate" method="POST")
                .form-group
                    label(for="firstNumber") Số thứ nhất
                    input#firstNumber(type="number" step="any" name="firstNumber" value=firstNumber placeholder="Ví dụ: 120" required)

                .form-group
                    label(for="secondNumber") Số thứ hai
                    input#secondNumber(type="number" step="any" name="secondNumber" value=secondNumber placeholder="Ví dụ: 30" required)

                .form-group
                    label Chọn phép tính

                    .operation-grid
                        each item, key in operations
                            label.operation-option
                                input(type="radio" name="operation" value=key checked=operation === key required)
                                span.operation-card
                                    strong= item.symbol
                                    small= item.name

                button.btn.btn-primary.btn-block(type="submit") ⚡ THỰC HIỆN TÍNH TOÁN

                a.btn.btn-secondary.btn-block(href="/calculator") Nhập lại

        section.panel
            .panel-heading
                h2 Kết quả tính toán
                span.tag SERVER RESPONSE

            if error
                .result-box.error-result
                    .result-icon !
                    .eyebrow HTTP 400 — BAD REQUEST
                    h2 Lỗi tính toán
                    p= error

            else if result
                .result-box.success-result
                    .eyebrow CALCULATION SUCCESS
                    p= result.expression
                    .big-result#resultValue= result.result
                    span.status-success ✓ Tính toán thành công
                    button.btn.btn-secondary(type="button" data-copy=result.result) Sao chép kết quả

            else
                .result-box
                    .eyebrow WAITING FOR INPUT
                    .big-result 0
                    p Nhập hai số để bắt đầu tính toán.

            .panel-divider

            h3 Thông tin xử lý

            .system-row
                span Method
                strong POST

            .system-row
                span Endpoint
                strong /calculate

            .system-row
                span Controller
                strong calculate()

            .system-row
                span Model
                strong calculatorModel

            .system-row
                span Lưu dữ liệu
                strong history.json

    .panel
        h2 Các phép tính được hỗ trợ

        .technology-grid
            each item in [{symbol:"+",name:"Phép cộng",example:"10 + 20 = 30"},{symbol:"-",name:"Phép trừ",example:"50 - 20 = 30"},{symbol:"×",name:"Phép nhân",example:"25 × 4 = 100"},{symbol:"÷",name:"Phép chia",example:"120 ÷ 30 = 4"}]
                .technology-card
                    .operation-symbol= item.symbol
                    h3= item.name
                    p= item.example
